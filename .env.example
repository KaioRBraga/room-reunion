# Copie este arquivo para .env e ajuste os valores reais. NUNCA commite o .env.

# Flask
SECRET_KEY=troque-esta-chave-por-uma-aleatoria
FLASK_ENV=production

# Banco de dados (default: SQLite em instance/readyroom.sqlite3)
DATABASE_URL=

# Active Directory / LDAP (mesmos valores do projeto ldap_user_creator)
DOMINIO_AD=MOTIVA
SERVIDOR_AD=10.100.0.10
BASE_DN=dc=motiva,dc=matriz
LDAP_PORT=636

# Grupos AD (cn) que podem gerenciar salas, separados por vírgula
GRUPOS_ADMIN_SALAS=g_fg_analistas_ti

# Tamanho máximo de upload do mapa, em MB
MAX_UPLOAD_MB=15
