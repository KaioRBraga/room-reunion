# Copie este arquivo para .env e ajuste os valores reais. NUNCA commite o .env.

# Flask
SECRET_KEY=troque-esta-chave-por-uma-aleatoria
FLASK_ENV=production

# Banco de dados (default: SQLite em instance/readyroom.sqlite3)
DATABASE_URL=

# Active Directory / LDAP (mesmos valores do projeto ldap_user_creator)
DOMINIO_AD=MOTIVA
SERVIDOR_AD=10.100.0.10
BASE_DN=dc=motiva,dc=matriz
LDAP_PORT=636

# Grupos AD (cn) que podem gerenciar salas, separados por vírgula
GRUPOS_ADMIN_SALAS=g_fg_analistas_ti

# Conta de serviço (somente leitura) para consultas ao AD fora do login -
# necessária para listar grupos na aba de permissão de salas e para checar
# permissão de quem agenda pelo PIN do tablet (sem sessão web).
LDAP_SERVICE_USER=
LDAP_SERVICE_PASSWORD=

# Prefixos do cn dos grupos do AD a listar na aba de permissão de salas,
# separados por vírgula. Sem isso, a lista traz TODOS os grupos do AD
# (incluindo ~400 grupos nativos do Windows). Vazio = lista todos.
AD_GROUP_PREFIXES=g_,INT-

# Tamanho máximo de upload do mapa, em MB
MAX_UPLOAD_MB=15

# URL fixa do servidor (ex: http://10.100.0.20:5000) usada para montar o QR
# code de pareamento na aba Dispositivos. Defina sempre que o servidor puder
# ser acessado por mais de um endereço (localhost na máquina do admin vs IP
# de rede usado pelos tablets/celulares) para o QR não sair com 127.0.0.1.
PUBLIC_BASE_URL=
